extends "res://tests/workbench_ui_checks.gd"

func _run() -> void:
	evidence = ProjectSettings.globalize_path("res://artifacts/placement-ui-%d" % int(Time.get_unix_time_from_system()))
	DirAccess.make_dir_recursive_absolute(evidence)
	main = MainScene.instantiate()
	root.add_child(main)
	main.save_path = evidence.path_join("world.json")
	main.automated = true
	create_timer(60).timeout.connect(func():
		if not finished:
			printerr("FAIL placement UI timed out")
			quit(1))
	await _settle()
	await _click(main.new_game_button.get_global_rect().get_center())
	main.set_physics_process(false)
	var tiles: Array = main.world.data.deck_tiles.duplicate()
	for shape in [Vector2i(1280, 800), Vector2i(960, 600)]:
		root.size = shape
		main.world.data.deck_tiles = tiles.duplicate()
		main.world.data.structures = {"bedroll_0": main.world._new_structure("bedroll_0", "bedroll", Vector2(416, 224))}
		main.world.data.chests = {}
		_fixture_player("deck", Vector2(480, 288))
		_player().bag = Inventory.empty_slots(12)
		for item in ["wood", "rope", "plastic", "saltwater"]:
			Inventory.add(_player().bag, item, 20)
		main.view.feedback.reset()
		await _settle()
		await _tap(KEY_C)
		await _recipe("chest", "survival")
		await _click(main.crafting_ui.make_button.get_global_rect().get_center())
		await _hold_crafted("chest")
		var before: Array = _player().bag.duplicate(true)
		for row in [[Vector2(608, 288), "没有地板"], [Vector2(416, 224), "已有设施"], [Vector2(480, 288), "有人"]]:
			await _move_mouse(_world_point(row[0], "deck"))
			await _settle()
			_check(main.hud.build_box.visible and main.hud.build_reason.text.contains(row[1]) and not main.view.placement.valid, "live reason without clicking: " + row[1])
			await _click(_world_point(row[0], "deck"))
			_check(_player().bag == before and main.world.data.chests.is_empty(), "invalid real click preserves all materials")
			await _capture("blocked-%s-%d.png" % [row[1], shape.x])
		await _move_mouse(_world_point(Vector2(544, 224), "deck"))
		await _settle()
		_check(main.view.placement.valid and main.hud.build_reason.text.contains("可以"), "real valid cell updates card")
		await _click(_world_point(Vector2(544, 224), "deck"), MOUSE_BUTTON_RIGHT)
		_check(main.placement_recipe.is_empty() and _player().bag == before and not main.hud.build_box.visible, "right-click cancel clears card and spends nothing")
		await _tap(KEY_C)
		await _recipe("foundation", "survival")
		await _click(main.crafting_ui.make_button.get_global_rect().get_center())
		await _hold_crafted("foundation")
		await _move_mouse(_world_point(Vector2(608, 288), "deck"))
		await _capture("floor-preview-%d.png" % shape.x)
		await _tap(KEY_O)
		_check("9,4" in main.world.data.deck_tiles and _has_effect("build"), "O places foundation under pointer and confirms with feedback")
		await _capture("floor-built-%d.png" % shape.x)
		await _tap(KEY_C)
		await _recipe("purifier", "survival")
		await _click(main.crafting_ui.make_button.get_global_rect().get_center())
		await _hold_crafted("purifier")
		await _click(_world_point(Vector2(480, 224), "deck"))
		_check(main.world.data.structures.has("structure_0") and _has_effect("build"), "actual facility placement produces landing feedback")
		await _capture("facility-built-%d.png" % shape.x)
		await _click(_world_point(Vector2(480, 224), "deck"), MOUSE_BUTTON_RIGHT)
		await _choose_context("purify")
		_check(main.world.data.structures.structure_0.remaining > 0, "real context action starts processing")
		main.world.tick(12.1)
		await _settle(0.12)
		_check(_has_effect("ready") and Inventory.count(_player().bag, "freshwater") == 0, "finished processing has ready effect but no fake gain")
		await _capture("ready-%d.png" % shape.x)
		await _click(_world_point(Vector2(480, 224), "deck"))
		_check(Inventory.count(_player().bag, "freshwater") == 1 and _has_effect("gain"), "left-click collection shows confirmed amount")
		await _capture("collected-%d.png" % shape.x)
		main.world.data.navigation.anchored = true
		_fixture_player("deck", Vector2(555, 352))
		await _settle()
		await _tap(KEY_P)
		await _choose_context("dive")
		_check(_player().area == "water" and _has_effect("splash"), "real dive action produces water feedback")
		await _capture("dive-%d.png" % shape.x)
		_fixture_player("water", Vector2(120, 80))
		await _settle()
		await _tap(KEY_P)
		await _choose_context("surface")
		_check(_player().area == "deck" and _has_effect("splash"), "real surface action produces arrival feedback")
		await _capture("surface-%d.png" % shape.x)
		var saved_bag: Array = _player().bag.duplicate(true)
		_player().bag = Inventory.empty_slots(12)
		for entry in [["wood", 10], ["scrap", 6], ["rope", 4], ["cup", 8991]]:
			Inventory.add(_player().bag, entry[0], entry[1])
		await _tap(KEY_C)
		await _recipe("harpoon", "exploration")
		_check(main.crafting_ui.make_button.disabled and main.crafting_ui.make_button.text.contains("背包"), "full bag explains capacity before clicking Make")
		await _capture("full-bag-%d.png" % shape.x)
		Inventory.remove(_player().bag, "wood", 7)
		await _settle()
		_check(not main.crafting_ui.make_button.disabled, "using the last ingredient stack counts as newly available result space")
		await _click(main.crafting_ui.make_button.get_global_rect().get_center())
		_check(Inventory.count(_player().bag, "harpoon") == 1, "real craft fills the consumed ingredient slot")
		await _tap(KEY_C)
		_player().bag = saved_bag

	root.size = Vector2i(1440, 600)
	_fixture_player("deck", Vector2(544, 288))
	await _settle()
	await _tap(KEY_C)
	await _recipe("foundation", "survival")
	await _click(main.crafting_ui.make_button.get_global_rect().get_center())
	await _hold_crafted("foundation")
	await _move_mouse(_world_point(Vector2(672, 288), "deck"))
	await _settle()
	_check(main.view.placement.get("valid", false), "ultrawide mouse still selects correct foundation cell")
	await _capture("ultrawide-preview.png")
	if DisplayServer.get_name() != "headless":
		await _tap(KEY_F11)
		await _settle(0.3)
		await _move_mouse(_world_point(Vector2(672, 288), "deck"))
		await _settle()
		_check(root.mode == Window.MODE_EXCLUSIVE_FULLSCREEN and main.view.placement.get("valid", false), "fullscreen preserves placement card and mouse coordinates")
		await _capture("fullscreen-preview.png")
		await _click(_world_point(Vector2(672, 288), "deck"))
		_check("10,4" in main.world.data.deck_tiles, "fullscreen click builds the actual preview cell")
		await _tap(KEY_F11)
	finished = true
	print("PLACEMENT UI: %d checks, %d failures; %s" % [checks, failures, evidence])
	quit(0 if failures == 0 else 1)

func _has_effect(kind: String) -> bool:
	for effect in main.view.feedback.effects:
		if effect.kind == kind:
			return true
	return false
