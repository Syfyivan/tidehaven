extends "res://tests/progression_test.gd"
const Feedback = preload("res://scripts/scene_feedback.gd")

func _initialize() -> void:
	_test_reasons()
	_test_confirmed_feedback()
	_test_hook_feedback()
	_test_craft_capacity()
	_test_relocation()
	print("PLACEMENT / FEEDBACK: %d checks, %d failures" % [checks, failures])
	quit(0 if failures == 0 else 1)

func _test_reasons() -> void:
	var world = _world(true)
	_place(world, "guest", "deck", 544, 352)
	_give(world, "host", {"wood": 20, "plastic": 20, "rope": 20})
	var cases := [
		["chest", 608, 288, "没有地板"], ["chest", 416, 224, "已有设施"],
		["chest", 480, 288, "有人"], ["chest", 544, 352, "有人"],
		["foundation", 480, 224, "已经有地板"], ["foundation", 608, 416, "接在"],
		["chest", 736, 288, "距离太远"], ["foundation", 800, 288, "边界"],
		["chest", 500, 224, "对齐"], ["furnace", 480, 224, "工作台"]]
	for row in cases:
		var before: Dictionary = world.snapshot()
		var reason: String = world.placement_reason("host", row[0], row[1], row[2], true)
		var message: String = world.action("host", "craft", {"recipe": row[0], "x": float(row[1]), "y": float(row[2])})
		_check(reason.contains(row[3]) and message.contains(row[3]) and world.snapshot() == before, "preview and execution agree without spending: " + row[3])
	_check(not world.can_place("host", "chest", NAN, 224) and not world.can_place("missing", "chest", 480, 224), "nonfinite or offline previews safely reject")
	world.data.structures.barrier = world._new_structure("barrier", "grill", Vector2(480, 352))
	_place(world, "host", "deck", 416, 288)
	_check(world.placement_reason("host", "chest", 480, 288).contains("通道"), "closing the only corridor explains blocked passage")
	world = _world(true)
	_place(world, "guest", "deck", 544, 288)
	world.data.players.host.bag = Inventory.empty_slots(12)
	_give(world, "guest", {"wood": 20})
	_check(world.placement_reason("host", "chest", 544, 224, true).contains("木板"), "partner bag cannot cover a material deficit")
	world.data.chests.chest_5 = world._new_chest("chest_5", "材料箱", Vector2(416, 352), Inventory.empty_slots(16))
	Inventory.add(world.data.chests.chest_5.slots, "wood", 8)
	Inventory.add(world.data.chests.chest_5.slots, "rope", 2)
	_check(world.placement_reason("host", "chest", 544, 224, true).is_empty(), "shared chest materials count in preview")
	world.action("guest", "craft", {"recipe": "chest", "x": 544.0, "y": 224.0})
	var before: Dictionary = world.snapshot()
	var result: String = world.action("host", "craft", {"recipe": "chest", "x": 544.0, "y": 224.0})
	_check(result.contains("已有设施") and world.snapshot() == before, "partner wins same-cell race; loser spends nothing")
	_check(world.relocation_reason("guest", "chest_0", 544, 224, 544, 224).contains("原位置"), "moving to original cell explains no-op")
	_check(world.relocation_reason("host", "chest_0", 480, 224, 480, 352).contains("伙伴"), "stale move identifies relocated source")
	_place(world, "host", "deck", 416, 288)
	_check(world.relocation_reason("host", "chest_0", 544, 224, 480, 352).contains("靠近"), "moving from too far identifies source distance")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(world.snapshot()))
	var restored = WorldState.new()
	var restored_ok: bool = restored.restore(saved)
	_check(restored_ok and JSON.parse_string(JSON.stringify(restored.data.chests)) == saved.chests, "new layout and contents survive restore")

func _count_effects(feedback, kind: String) -> int:
	var count := 0
	for effect in feedback.effects:
		if effect.kind == kind:
			count += 1
	return count

func _test_confirmed_feedback() -> void:
	var world = _world()
	_give(world, "host", {"wood": 20, "plastic": 20, "rope": 2})
	var feedback = Feedback.new()
	feedback.update(world.data, "host", 0)
	_check(feedback.effects.is_empty(), "opening a world emits no fake pickups or builds")
	world.action("host", "craft", {"recipe": "chest", "x": 416.0, "y": 224.0})
	feedback.update(world.data, "host", 0)
	_check(feedback.effects.is_empty(), "rejected build has no success effect")
	world.action("host", "craft", {"recipe": "chest", "x": 544.0, "y": 224.0})
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "build") == 1, "host-confirmed build produces one landing effect")
	feedback.update(world.snapshot(), "host", 0)
	_check(_count_effects(feedback, "build") == 1, "duplicate network snapshot does not replay effect")
	world.action("host", "craft", {"recipe": "foundation", "x": 608.0, "y": 288.0})
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "build") == 2, "actual foundation addition gets landing effect")
	world.action("host", "craft", {"recipe": "cup"})
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "gain") == 1, "real gain yields inventory count feedback")
	var before: Dictionary = world.snapshot()
	feedback.update(world.data, "host", 2)
	_check(feedback.effects.is_empty() and world.snapshot() == before, "feedback expires without modifying simulation")
	world.action("host", "craft", {"recipe": "cup"})
	feedback.update(world.data, "host", 0, false)
	feedback.update(world.data, "host", 0, true)
	_check(feedback.effects.is_empty(), "inventory/modal gains stay silent and do not replay after closing")
	world = _furnace_world()
	world.action("host", "smelt", {"id": "structure_0"})
	feedback.reset()
	feedback.update(world.data, "host", 0)
	_check(feedback.effects.is_empty(), "reserved output during processing is not completed output")
	world.tick(15.1)
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "ready") == 1 and _count_effects(feedback, "gain") == 0, "timer completion signals ready, not already in inventory")
	world.data.players.host.bag = Inventory.empty_slots(12)
	Inventory.add(world.data.players.host.bag, "wood", Inventory.BAG_SIZE * Inventory.STACK_LIMIT)
	feedback.reset()
	feedback.update(world.data, "host", 0)
	world.action("host", "collect_output", {"id": "structure_0"})
	feedback.update(world.data, "host", 0)
	_check(feedback.effects.is_empty() and world.data.structures.structure_0.output == "ingot", "full pack collection does not emit fake gain")
	world.data.navigation.anchored = true
	_place(world, "host", "deck", 555, 288)
	feedback.update(world.data, "host", 0)
	world.action("host", "dive")
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "splash") == 2, "successful dive marks both sides of transition")
	_place(world, "host", "water", 120, 80)
	feedback.update(world.data, "host", 2)
	world.action("host", "surface")
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "splash") == 2, "successful surface marks both scenes")
	feedback.update({}, "host", 0)
	feedback.update(world.snapshot(), "host", 0)
	_check(feedback.effects.is_empty(), "return-to-title and continue establish a quiet baseline")


func _test_hook_feedback() -> void:
	var world = _world()
	Skills.stage_drift(world, "drift_00", 100)
	var feedback = Feedback.new()
	feedback.update(world.data, "host", 0)
	world.action("host", "hook", {"x": 1.0, "y": 0.0})
	feedback.update(world.data, "host", 0)
	Skills.await_hook_contact(world, "host")
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "splash") == 1 and _count_effects(feedback, "gain") == 0 and _count(world, "host", "wood") == 0, "hook contact splashes but does not pretend cargo is already in bag")
	Skills.reel(world, ["host"])
	feedback.update(world.data, "host", 0)
	_check(_count_effects(feedback, "gain") == 1 and _count(world, "host", "wood") == 2, "reeling all the way home shows actual inventory increase")
	feedback.update(world.snapshot(), "host", 0)
	_check(_count_effects(feedback, "gain") == 1, "duplicate action confirmation never doubles pickup feedback")

func _test_craft_capacity() -> void:
	var world = _world()
	var bag: Array = world.data.players.host.bag
	Inventory.add(bag, "wood", 10)
	Inventory.add(bag, "scrap", 6)
	Inventory.add(bag, "rope", 4)
	Inventory.add(bag, "cup", 9 * Inventory.STACK_LIMIT)
	var before: Dictionary = world.snapshot()
	_check(not Recipes.output_fits(bag, "harpoon") and world.snapshot() == before, "capacity preview is read-only and rejects full bag with no consumed slot")
	world.action("host", "craft", {"recipe": "harpoon"})
	_check(world.snapshot() == before, "host agrees and keeps all materials on full bag failure")
	Inventory.remove(bag, "wood", 7)
	_check(Recipes.output_fits(bag, "harpoon"), "consuming the last wood stack frees space for the result")
	world.action("host", "craft", {"recipe": "harpoon"})
	_check(_count(world, "host", "harpoon") == 1 and _count(world, "host", "wood") == 0, "host actually uses newly freed space without rearranging other slots")
	bag = Inventory.empty_slots(12)
	Inventory.add(bag, "leaf", 20)
	Inventory.add(bag, "rope", Inventory.STACK_LIMIT - 1)
	Inventory.add(bag, "cup", 10 * Inventory.STACK_LIMIT)
	_check(Recipes.output_fits(bag, "rope"), "existing result stack with room works in a full bag")
	Inventory.add(bag, "rope", 1)
	_check(not Recipes.output_fits(bag, "rope"), "full result stack requires another slot")
